{
  "algorithm": {
    "name": "BC",
    "policy": {
      "name": "MLP",
      "params": {
        "low_dim_hidden_sizes": [
          32,
          64
        ],
        "hidden_sizes": [
          600,
          1000,
          600,
          300
        ],
        "activation": "ReLU",
        "output_activation": null,
        "use_gmm": true,
        "encoder": {
          "name": "ResNet18",
          "siamese": true,
          "params": {
            "img_size": 200,
            "crop_size": 185,
            "SpatialSoftmax": {
              "num_kp": 32,
              "in_c": 512,
              "in_h": 4,
              "in_w": 4
            }
          }
        }
      }
    },
    "optimizer": {
      "name": "Adam",
      "params": {
        "lr": 0.001
      }
    },
      "loss":
      {
        "name": "MSELoss",
        "weight":
        {
          "weight_tr": 1.0,
          "weight_rot": 1.0
        }
      }
},
  "training": {
    "finetune":false,
    "num_epochs": 1000,
    "num_epochs_logging_and_valid": 10,
    "num_train_steps_per_epoch": 100,
    "num_val_steps_per_epoch": 10,
    "num_epochs_save": 1,
    "batch_size": 32,
    "num_data_workers": 2
  },
  "dataset": {
    "hdf5_path": "wp/Panda_Panda_TwoArmPickPlace_2025-01-02_17-10-41/demo.hdf5",
    "specific_obs_keys": [
      "robot0_eye_in_hand_image",
      "robot0_eye_in_hand_image_goal",
      "abs_rot"
    ],
    "num_demos": 5001,
    "seq_length": 10,
    "input_low_dim": 1,
    "output_dim": 3,
    "hdf5_cache_mode": "low_dim",
    "hdf5_use_swmr": true,
    "bgr2rgb": false
  },

  "seed": 42,
  "model_out_dir": "trial",
  "log_dir": "trial"

}