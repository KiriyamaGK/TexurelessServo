{
  "algorithm": {
    "name": "BC",
    "policy": {
      "name": "MLP",
      "params": {
        "low_dim_hidden_sizes": [
          32,
          64
        ],
        "hidden_sizes": [
          600,
          1000,
          600,
          300
        ],
        "activation": "ReLU",
        "output_activation": null,
        "use_gmm": true,
        "encoder": {
          "name": "ResNet18",
          "num_cameras": 2,
          "using_depth": false,
          "using_pose_estimation": false,
          "data_augmentation": false,
          "task_consistency_loss": false,
          "mixed_light_dataset":false,
          "pretrained_path": "ultralytics/runs/pose/train/weights/best.pt",
          "freeze":false,
          "siamese": false,
          "params": {
            "num_layers": 11,
            "img_size": 200,
            "crop_size": 200,
            "SpatialSoftmax": {
              "num_kp": 32,
              "in_c": 512,
              "in_h": 7,
              "in_w": 7
            }
          }
        }
      }
    },
    "optimizer": {
      "name": "Adam",
      "params": {
        "lr": 0.0001
      }
    },
      "loss":
      {
        "name": "CustomLoss",
        "weight":
        {
          "weight_tr": 0.5,
          "weight_rot": 1.0
        }
      }
},
  "training": {
    "finetune":false,
    "num_epochs": 1000,
    "num_epochs_logging_and_valid": 1,
    "num_train_steps_per_epoch": 1000,
    "num_val_steps_per_epoch": 10,
    "num_epochs_save": 10,
    "batch_size": 16,
    "num_data_workers": 2
  },
  "dataset": {
    "hdf5_path": "One Touch/AlignAnything/25.04.17/hdf5/mimic.hdf5",
    "specific_obs_keys": [
      "robot0_eye_in_hand_image",
      "robot0_eye_in_hand_image_goal",
      "robot0_eye_in_hand_image_2",
      "robot0_eye_in_hand_image_2_goal"
    ],
    "label_keys": ["actions"],
    "num_demos": 5000,
    "seq_length": 1,
    "input_low_dim": 0,
    "output_dim": 6,
    "hdf5_cache_mode": "low_dim",
    "hdf5_use_swmr": true,
    "bgr2rgb": false
  },

  "seed": 42,
  "model_out_dir": "trial",
  "log_dir": "trial"
}